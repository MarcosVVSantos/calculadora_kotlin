<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1624">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1A2540"
        android:elevation="4dp"
        android:theme="@style/Theme.Checkbox.Toolbar"
        app:titleTextColor="#FFFFFF"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- SEÇÃO: Velocidade Média -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="16dp" android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cinematica_vel_media"
                    android:textColor="#00C9A7" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cinematica_vel_formula"
                    android:textColor="#8B9CC8" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Variação de espaço Δs (m)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtVelDeltaS"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Variação de tempo Δt (s)" android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtVelDeltaT"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnCalcVel" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:text="@string/btn_calcular" android:textAllCaps="false"
                        android:backgroundTint="#00C9A7" android:textColor="#0F1624"/>
                    <Button android:id="@+id/btnLimparVel" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        android:text="@string/btn_limpar" android:textAllCaps="false"
                        android:backgroundTint="#2D3A52" android:textColor="#8B9CC8"/>
                </LinearLayout>
                <TextView android:id="@+id/tvResultVel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#00C9A7"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- SEÇÃO: Aceleração Média -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="16dp" android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cinematica_acel"
                    android:textColor="#00C9A7" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cinematica_acel_formula"
                    android:textColor="#8B9CC8" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Variação de velocidade Δv (m/s)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtAcelDeltaV"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Variação de tempo Δt (s)" android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtAcelDeltaT"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnCalcAcel" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:text="@string/btn_calcular" android:textAllCaps="false"
                        android:backgroundTint="#00C9A7" android:textColor="#0F1624"/>
                    <Button android:id="@+id/btnLimparAcel" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        android:text="@string/btn_limpar" android:textAllCaps="false"
                        android:backgroundTint="#2D3A52" android:textColor="#8B9CC8"/>
                </LinearLayout>
                <TextView android:id="@+id/tvResultAcel" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#00C9A7"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- SEÇÃO: MRU -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="16dp" android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cinematica_mru"
                    android:textColor="#00C9A7" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cinematica_mru_formula"
                    android:textColor="#8B9CC8" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Posição inicial s₀ (m)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMruS0"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Velocidade v (m/s)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMruV"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Tempo t (s)" android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMruT"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnCalcMru" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:text="@string/btn_calcular" android:textAllCaps="false"
                        android:backgroundTint="#00C9A7" android:textColor="#0F1624"/>
                    <Button android:id="@+id/btnLimparMru" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        android:text="@string/btn_limpar" android:textAllCaps="false"
                        android:backgroundTint="#2D3A52" android:textColor="#8B9CC8"/>
                </LinearLayout>
                <TextView android:id="@+id/tvResultMru" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#00C9A7"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- SEÇÃO: MRUV Posição -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="16dp" android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cinematica_mruv_pos"
                    android:textColor="#00C9A7" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cinematica_mruv_formula"
                    android:textColor="#8B9CC8" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Posição inicial s₀ (m)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMruvS0"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Velocidade inicial v₀ (m/s)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMruvV0"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Aceleração a (m/s²)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMruvA"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Tempo t (s)" android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMruvT"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnCalcMruv" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:text="@string/btn_calcular" android:textAllCaps="false"
                        android:backgroundTint="#00C9A7" android:textColor="#0F1624"/>
                    <Button android:id="@+id/btnLimparMruv" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        android:text="@string/btn_limpar" android:textAllCaps="false"
                        android:backgroundTint="#2D3A52" android:textColor="#8B9CC8"/>
                </LinearLayout>
                <TextView android:id="@+id/tvResultMruv" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#00C9A7"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- SEÇÃO: MRUV Velocidade Final -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="16dp" android:layout_marginBottom="8dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cinematica_mruv_vel"
                    android:textColor="#00C9A7" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/cinematica_mruv_vel_formula"
                    android:textColor="#8B9CC8" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Velocidade inicial v₀ (m/s)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMruvVfV0"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Aceleração a (m/s²)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMruvVfA"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Tempo t (s)" android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtMruvVfT"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnCalcMruvVf" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:text="@string/btn_calcular" android:textAllCaps="false"
                        android:backgroundTint="#00C9A7" android:textColor="#0F1624"/>
                    <Button android:id="@+id/btnLimparMruvVf" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        android:text="@string/btn_limpar" android:textAllCaps="false"
                        android:backgroundTint="#2D3A52" android:textColor="#8B9CC8"/>
                </LinearLayout>
                <TextView android:id="@+id/tvResultMruvVf" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#00C9A7"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>