<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1624">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1A2540"
        android:elevation="4dp"
        android:theme="@style/Theme.Checkbox.Toolbar"
        app:titleTextColor="#FFFFFF"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecione uma área:"
                android:textColor="#8B9CC8"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnCinematica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fisica_cinematica"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00C9A7"
                android:textColor="#0F1624"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnDinamica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fisica_dinamica"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#00A88C"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnEnergia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fisica_energia"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#008870"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnTermologia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fisica_termologia"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#007060"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnOptica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fisica_optica"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#005A50"
                android:textColor="#FFFFFF"
                android:padding="14dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>