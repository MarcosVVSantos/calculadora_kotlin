<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1624">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1A2540"
        android:elevation="4dp"
        android:theme="@style/Theme.Checkbox.Toolbar"
        app:titleTextColor="#FFFFFF"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecione uma área:"
                android:textColor="#8B9CC8"
                android:textSize="14sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnGeoPlana"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mat_geo_plana"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#4F7FFA"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnGeoEspacial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mat_geo_espacial"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#3D6DE0"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnEquacoes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mat_equacoes"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#2C5DC8"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnTrigonometria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mat_trigonometria"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#1B4DB0"
                android:textColor="#FFFFFF"
                android:padding="14dp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnEstatistica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mat_estatistica"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:backgroundTint="#0D3D98"
                android:textColor="#FFFFFF"
                android:padding="14dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>