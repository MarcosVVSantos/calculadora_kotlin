<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1624">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#1A2540"
        android:elevation="4dp"
        android:theme="@style/Theme.Checkbox.Toolbar"
        app:titleTextColor="#FFFFFF"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Dilatação Linear -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="16dp" android:layout_marginBottom="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/termo_dilatacao"
                    android:textColor="#00C9A7" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/termo_dilatacao_formula"
                    android:textColor="#8B9CC8" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Comprimento inicial L₀ (m)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDilatL0"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Coeficiente de dilatação α (ex: 0.000012)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDilatAlpha"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Variação de temperatura ΔT (°C)" android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDilatDeltaT"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnCalcDilat" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:text="@string/btn_calcular" android:textAllCaps="false"
                        android:backgroundTint="#00C9A7" android:textColor="#0F1624"/>
                    <Button android:id="@+id/btnLimparDilat" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        android:text="@string/btn_limpar" android:textAllCaps="false"
                        android:backgroundTint="#2D3A52" android:textColor="#8B9CC8"/>
                </LinearLayout>
                <TextView android:id="@+id/tvResultDilat" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#00C9A7"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Quantidade de Calor -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:background="@drawable/bg_card"
                android:padding="16dp" android:layout_marginBottom="8dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/termo_calor"
                    android:textColor="#00C9A7" android:textStyle="bold" android:textSize="18sp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/termo_calor_formula"
                    android:textColor="#8B9CC8" android:textSize="14sp" android:layout_marginBottom="12dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Massa m (kg)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCalorM"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Calor específico c (J/kg·°C)" android:layout_marginBottom="8dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCalorC"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="Variação de temperatura ΔT (°C)" android:layout_marginBottom="12dp"
                    app:boxBackgroundMode="outline" app:boxBackgroundColor="#1A2236"
                    app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
                    app:boxStrokeColor="#00C9A7" app:hintTextColor="#8B9CC8">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCalorDeltaT"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:inputType="numberDecimal|numberSigned" android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnCalcCalor" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginEnd="6dp"
                        android:text="@string/btn_calcular" android:textAllCaps="false"
                        android:backgroundTint="#00C9A7" android:textColor="#0F1624"/>
                    <Button android:id="@+id/btnLimparCalor" android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:layout_marginStart="6dp"
                        android:text="@string/btn_limpar" android:textAllCaps="false"
                        android:backgroundTint="#2D3A52" android:textColor="#8B9CC8"/>
                </LinearLayout>
                <TextView android:id="@+id/tvResultCalor" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#00C9A7"
                    android:textSize="16sp" android:textStyle="bold" android:layout_marginTop="10dp"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>