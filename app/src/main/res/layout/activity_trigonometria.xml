<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Calculadora Trigonométrica"
        android:textAlignment="center"
        android:textColor="#1E3A5F"
        android:textSize="26sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Digite o ângulo em graus"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="#3B82F6">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtAngulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:text="Escolha as operações:"
        android:textColor="#1E3A5F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <CheckBox
        android:id="@+id/checkSeno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#2563EB"
        android:text="Seno"
        android:textColor="#333333"
        android:textSize="16sp" />

    <CheckBox
        android:id="@+id/checkCosseno"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#2563EB"
        android:text="Cosseno"
        android:textColor="#333333"
        android:textSize="16sp" />

    <CheckBox
        android:id="@+id/checkTangente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="#2563EB"
        android:text="Tangente"
        android:textColor="#333333"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:backgroundTint="#2563EB"
        android:text="Calcular"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnVoltarMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Voltar ao Menu"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:backgroundTint="#6B7280"
        android:textColor="#FFFFFF"
        android:layout_marginTop="12dp"/>

    <TextView
        android:id="@+id/txtResultado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="24dp"
        android:textColor="#111827"
        android:textSize="20sp"
        android:textStyle="bold" />

</LinearLayout>